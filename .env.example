# Gmail SMTP Configuration
# 1. Turn on 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and the 16-character App Password below:
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_16_character_app_password

# Notification Target
RECIPIENT_EMAIL=prateekpkini2005@gmail.com

# Polling Interval (in seconds, default: 60)
CHECK_INTERVAL_SECONDS=60

# Optional Web Server Port (Render sets this automatically)
PORT=10000
